# SimplePay Fizetési Integráció - Környezeti Változók

# SimplePay Merchant ID (az OTP-től kapott azonosító)
SIMPLEPAY_MERCHANT_ID=your_merchant_id_here

# SimplePay Secret Key (titkos kulcs az OTP-től)
SIMPLEPAY_SECRET_KEY=your_secret_key_here

# Sandbox mód (true = teszt környezet, false = éles környezet)
SIMPLEPAY_SANDBOX=true

# Flask secret key (session titkosításhoz)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database path
DATABASE=kajak_kenu.db
