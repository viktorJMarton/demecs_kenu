# SimplePay konfiguráció
# A teszt környezethez használt merchant ID és secret key
# Éles környezethez cseréld ki az éles adatokra!

SIMPLEPAY_MERCHANT_ID=your_test_merchant_id
SIMPLEPAY_SECRET_KEY=your_test_secret_key
SIMPLEPAY_SANDBOX=true

# Flask konfiguráció
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
DATABASE_URL=sqlite:///instance/flaskr.sqlite
