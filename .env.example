# SimplePay konfiguráció
# A teszt környezethez használt merchant ID és secret key
# Éles környezethez cseréld ki az éles adatokra!

SIMPLEPAY_MERCHANT_ID=your_test_merchant_id
SIMPLEPAY_SECRET_KEY=your_test_secret_key
SIMPLEPAY_SANDBOX=true

# Flask konfiguráció
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
DATABASE_URL=kajak_kenu.db

# Email / SMTP
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_gmail_username
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM="Demecs Kenu" <demecs.kenu@gmail.com>
CONTACT_RECIPIENT=demecs.kenu@gmail.com
