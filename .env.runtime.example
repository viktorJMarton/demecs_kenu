# Runtime
FLASK_ENV=production
FLASK_DEBUG=false
APP_BASE_URL=https://example.com
DATABASE_URL=/app/kajak_kenu.db
APP_LOG_DIR=/app/logs

# Generate independent random values of at least 32 characters.
SECRET_KEY=replace-with-random-secret
WTF_CSRF_SECRET_KEY=replace-with-independent-random-secret
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true

# Admin users. Generate password hashes with scripts/hash_admin_password.py.
ADMIN_USERS_JSON=[{"username":"admin","password_hash":"replace-with-generated-hash"}]

# SimplePay
SIMPLEPAY_MERCHANT_ID=replace-with-merchant-id
SIMPLEPAY_SECRET_KEY=replace-with-secret
SIMPLEPAY_SANDBOX=false
SIMPLEPAY_SDK_VERSION=SimplePayV2

# SMTP
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=replace-with-username
EMAIL_SMTP_PASSWORD=replace-with-app-password
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM=Example Service <noreply@example.com>
CONTACT_RECIPIENT=contact@example.com
SMTP_TEST_RECIPIENT=test-recipient@example.com
